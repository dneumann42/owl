; Owl's prelude. Everything here is written in Owl; the evaluator supplies
; only the primitives these are built from.

fun not value:
  pick value false true

command-define:
  condition-results = list

block-command if condition:
  define:
    result = eval condition
    then-result = pick result (eval block) nothing

  set
    condition-results
    cons (cons result (cons then-result (list))) condition-results
  then-result

fun take-condition-result:
  define:
    frame = first condition-results

  set condition-results (rest condition-results)
  frame

fun else-value frame else-block:
  pick (first frame) (first (rest frame)) (eval else-block)

block-command else:
  pick
    empty? condition-results
    eval block
    else-value (take-condition-result) block

;; When evaluated directly, a pipe continues the active condition frame. Other
;; block commands, such as cond, may instead consume pipe nodes as clause syntax.

block-command (|) condition:
  define:
    frame = take-condition-result
    matched = first frame
    previous = first (rest frame)
    result = pick matched true (eval condition)
    branch-result = pick matched previous (pick result (eval block) nothing)

  set
    condition-results
    cons (cons result (cons branch-result (list))) condition-results
  branch-result

block-command ([]):
  list-from (statements block)

block-command ({}):
  dict-from (statements block)

block-command (do):
  eval block

fun record-fields nodes:
  if (empty? nodes):
    list
  else:
    cons (binding-symbol (first nodes)) (record-fields (rest nodes))

fun record-defaults nodes:
  if (empty? nodes):
    list
  else:
    cons (binding-value (first nodes)) (record-defaults (rest nodes))

block-command record name:
  define:
    record-name = symbol-text name
    fields = statements block
    field-names = record-fields fields

  define-caller-value
    name
    record-constructor record-name field-names (record-defaults fields)
  define-caller-value
    concat record-name "?"
    record-predicate record-name field-names

fun unsupported-stream-operation:
  error "unsupported stream operation"

record Stream:
  open = value-of unsupported-stream-operation
  close = value-of unsupported-stream-operation
  read = value-of unsupported-stream-operation
  read-line = value-of unsupported-stream-operation
  read-all = value-of unsupported-stream-operation
  write = value-of unsupported-stream-operation
  write-line = value-of unsupported-stream-operation

fun close stream:
  call (field stream "close")

fun read stream:
  call (field stream "read")

fun read-line stream:
  call (field stream "read-line")

fun read-all stream:
  call (field stream "read-all")

fun write stream value:
  call (field stream "write") value

fun write-line stream value:
  call (field stream "write-line") value

fun cond-from clauses:
  if (empty? clauses):
    nothing
  else:
    define:
      clause = first clauses
      clause-symbol = command-symbol clause

    if (= clause-symbol "else"):
      eval (command-body clause)
    else:
      when (not (or (= clause-symbol "when") (= clause-symbol "|"))):
        error "cond expects when, |, or else"

      if (eval (command-arg clause 0)):
        eval (command-body clause)
      else:
        cond-from (rest clauses)

block-command cond:
  cond-from (statements block)

fun range start stop:
  define:
    current = start

  fun next:
    if (< current stop):
      define:
        value = current

      += current 1
      value
    else:
      nothing

  value-of next

fun countdown start stop:
  define:
    current = start

  fun next:
    if (> current stop):
      define:
        value = current

      -= current 1
      value
    else:
      nothing

  value-of next

fun iter values:
  define:
    index = 0
    count = length values

  fun next:
    if (< index count):
      define:
        value = nth values index

      += index 1
      value
    else:
      nothing

  value-of next

fun once value:
  define:
    pending = true

  fun next:
    if pending:
      set pending false
      value
    else:
      nothing

  value-of next

fun for-each item iterator body:
  define:
    value = iterator
    result = nothing

  while (not (= value nothing)):
    set result (eval-with item value body)
    set value (iterator)

  result

block-command for item iterator:
  for-each item (eval iterator) block

fun assert condition:
  when (not condition):
    error "assertion failed"

  condition
