block-command if condition:
  eval (pick (eval condition) (body-of block "then") (body-of block "else"))

fun list-from nodes:
  if (empty? nodes):
    then:
      list
    else:
      cons (eval (first nodes)) (list-from (rest nodes))

block-command ([]):
  list-from (statements block)

block-command (do):
  when true:
    eval block

fun dict-from nodes:
  if (empty? nodes):
    then:
      dict
    else:
      define:
        entry = (first nodes)
      dict-put (dict-from (rest nodes)) (binding-symbol entry) (eval (binding-value entry))

block-command ({}):
  dict-from (statements block)

fun record-fields nodes:
  if (empty? nodes):
    then:
      list
    else:
      define:
        entry = (first nodes)
      cons (binding-symbol entry) (record-fields (rest nodes))

fun record-defaults nodes:
  if (empty? nodes):
    then:
      list
    else:
      cons (binding-value (first nodes)) (record-defaults (rest nodes))

block-command record name:
  define:
    fields = (record-fields (statements block))
    defaults = (record-defaults (statements block))
  define-caller-value name (record-constructor fields defaults)

fun cond-from clauses:
  if (empty? clauses):
    then:
      nothing
    else:
      define:
        clause = (first clauses)
      when (not (= (command-symbol clause) "when")):
        when (not (= (command-symbol clause) "|")):
          error "cond expects when or |"
      if (eval (command-arg clause 0)):
        then:
          eval (command-body clause)
        else:
          cond-from (rest clauses)

block-command cond:
  cond-from (statements block)

fun nth values index:
  if (= index 0):
    then:
      first values
    else:
      nth (rest values) (- index 1)

fun append-value values value:
  if (empty? values):
    then:
      cons value (list)
    else:
      cons (first values) (append-value (rest values) value)

block-command append target value:
  set (value-of target) (append-value (eval target) (eval value))

fun read-line stream:
  call (field stream "read-line")

fun readline stream:
  read-line stream

fun read stream:
  read-line stream

fun write stream value:
  call (field stream "write") value

fun write-line stream value:
  call (field stream "write-line") value

fun assert condition:
  when (not condition):
    error "assertion failed"
  condition

fun range start stop:
  define:
    current = start
  fun next:
    if (< current stop):
      then:
        define:
          value = current
        += current 1
        value
      else:
        nothing
  value-of next

fun countdown start stop:
  define:
    current = start
  fun next:
    if (> current stop):
      then:
        define:
          value = current
        -= current 1
        value
      else:
        nothing
  value-of next

fun iter values:
  define:
    remaining = values
  fun next:
    if (empty? remaining):
      then:
        nothing
      else:
        define:
          value = (first remaining)
        set remaining (rest remaining)
        value
  value-of next

fun once value:
  define:
    pending = true
  fun next:
    if pending:
      then:
        set pending false
        value
      else:
        nothing
  value-of next

fun for-each item iterator body:
  define:
    value = (iterator)
    result = nothing
  while (not (= value nothing)):
    set result (eval-with item value body)
    set value (iterator)
  result

block-command for item iterator:
  for-each item (eval iterator) block
