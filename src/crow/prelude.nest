command-define:
  condition-results = (list)

block-command if condition:
  define:
    result = (eval condition)
    then-result = nothing
  when result:
    set then-result (eval block)
  set condition-results (cons (cons result (cons then-result (list))) condition-results)
  then-result

block-command else:
  define:
    pending = condition-results
    done = (empty? pending)
    result = nothing
  when (not done):
    set condition-results (rest pending)
    define:
      frame = (first pending)
      condition = (first frame)
      then-result = (first (rest frame))
  when done:
    set result (eval block)
  when (not done):
    when condition:
      set result then-result
    when (not condition):
      set result (eval block)
  result

fun list-from nodes:
  if (empty? nodes):
    list
  else:
    cons (eval (first nodes)) (list-from (rest nodes))

block-command ([]):
  list-from (statements block)

block-command (do):
  when true:
    eval block

fun dict-from nodes:
  if (empty? nodes):
    dict
  else:
    define:
      entry = (first nodes)
    dict-put (dict-from (rest nodes)) (binding-symbol entry) (eval (binding-value entry))

block-command ({}):
  dict-from (statements block)

fun record-fields nodes:
  if (empty? nodes):
    list
  else:
    define:
      entry = (first nodes)
    cons (binding-symbol entry) (record-fields (rest nodes))

fun record-defaults nodes:
  if (empty? nodes):
    list
  else:
    cons (binding-value (first nodes)) (record-defaults (rest nodes))

fun field-value fields name fallback:
  if (empty? fields):
    fallback
  else:
    define:
      entry = (first fields)
    if (= (binding-symbol entry) name):
      eval (binding-value entry)
    else:
      field-value (rest fields) name fallback

block-command record name:
  define:
    record-name = (symbol-text name)
    fields = (record-fields (statements block))
    defaults = (record-defaults (statements block))
  define-caller-value name (record-constructor record-name fields defaults)
  define-caller-value (concat record-name "?") (record-predicate record-name)

fun unsupported-stream-operation:
  error "unsupported stream operation"

record Stream:
  open = (value-of unsupported-stream-operation)
  close = (value-of unsupported-stream-operation)
  read = (value-of unsupported-stream-operation)
  read-line = (value-of unsupported-stream-operation)
  read-all = (value-of unsupported-stream-operation)
  write = (value-of unsupported-stream-operation)
  write-line = (value-of unsupported-stream-operation)

fun cond-from clauses:
  if (empty? clauses):
    nothing
  else:
    define:
      clause = (first clauses)
    when (not (= (command-symbol clause) "when")):
      when (not (= (command-symbol clause) "|")):
        error "cond expects when or |"
    if (eval (command-arg clause 0)):
      eval (command-body clause)
    else:
      cond-from (rest clauses)

block-command cond:
  cond-from (statements block)

fun nth values index:
  if (= index 0):
    first values
  else:
    nth (rest values) (- index 1)

fun append-value values value:
  if (empty? values):
    cons value (list)
  else:
    cons (first values) (append-value (rest values) value)

block-command append target value:
  set (value-of target) (append-value (eval target) (eval value))

fun drop-front values count:
  if (or (<= count 0) (empty? values)):
    values
  else:
    drop-front (rest values) (- count 1)

block-command pop-front target count:
  set (value-of target) (drop-front (eval target) (eval count))

fun close stream:
  call stream.close

fun read-line stream:
  call stream.read-line

fun read stream:
  call stream.read

fun read-all stream:
  call stream.read-all

fun write-line stream value:
  call stream.write-line value

fun write stream value:
  call stream.write value

fun assert condition:
  when (not condition):
    error "assertion failed"
  condition

fun range start stop:
  define:
    current = start
  fun next:
    if (< current stop):
      define:
        value = current
      += current 1
      value
    else:
      nothing
  value-of next

fun countdown start stop:
  define:
    current = start
  fun next:
    if (> current stop):
      define:
        value = current
      -= current 1
      value
    else:
      nothing
  value-of next

fun iter values:
  define:
    remaining = values
  fun next:
    if (empty? remaining):
      nothing
    else:
      define:
        value = (first remaining)
      set remaining (rest remaining)
      value
  value-of next

fun once value:
  define:
    pending = true
  fun next:
    if pending:
      set pending false
      value
    else:
      nothing
  value-of next

fun for-each item iterator body:
  define:
    value = (iterator)
    result = nothing
  while (not (= value nothing)):
    set result (eval-with item value body)
    set value (iterator)
  result

block-command for item iterator:
  for-each item (eval iterator) block
